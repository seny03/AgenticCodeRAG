# Proxy / TLS (optional, apply to all providers)
# Use if your API endpoint is only reachable via a proxy or needs a custom CA certificate
HTTPS_PROXY=
SSL_CERT_FILE= # /path/to/ca-bundle.pem


# Provider: Anthropic
ANTHROPIC_API_KEY=


# Provider: OpenAI
OPENAI_API_KEY=


# Provider: OpenAI-compatible server (including local e.g. ollama, vLLM):
OPENAI_COMPATIBLE_API_KEY=


# DraCo
# Path to the DraCo source checkout (defaults to vendor/DraCo).
DRACO_DIR=

# Logging
LOG_LEVEL=INFO
